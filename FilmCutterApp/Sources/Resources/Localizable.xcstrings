{
  "sourceLanguage": "en",
  "strings": {
    "frame.geometry.warning": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Some frames overlap. Check them before export." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "部分画格重叠，请在导出前检查。" } },
        "ja": { "stringUnit": { "state": "translated", "value": "重なっているコマがあります。書き出し前に確認してください。" } },
        "es": { "stringUnit": { "state": "translated", "value": "Hay fotogramas solapados. Revísalos antes de exportar." } },
        "fr": { "stringUnit": { "state": "translated", "value": "Certaines vues se chevauchent. Vérifiez-les avant l’export." } }
      }
    },
    "reorder.frames": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Renumber frames in reading order" } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "按画格阅读顺序重新编号" } },
        "ja": { "stringUnit": { "state": "translated", "value": "読み順にコマ番号を付け直す" } },
        "es": { "stringUnit": { "state": "translated", "value": "Renumerar fotogramas en orden de lectura" } },
        "fr": { "stringUnit": { "state": "translated", "value": "Renuméroter les vues dans l’ordre de lecture" } }
      }
    },
    "ERR_ENGINE": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The embedded processing engine failed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "内置处理引擎运行失败。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "内蔵処理エンジンでエラーが発生しました。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Falló el motor de procesamiento integrado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le moteur de traitement intégré a échoué."
          }
        }
      }
    },
    "ERR_NO_FRAMES": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No frames were detected. Add a frame manually or update detection."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未检测到画格，请手动添加或更新检测。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コマを検出できませんでした。手動で追加するか再検出してください。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se detectaron fotogramas. Añade uno manualmente o actualiza la detección."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune vue détectée. Ajoutez-en une manuellement ou relancez la détection."
          }
        }
      }
    },
    "ERR_NO_INPUT": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No TIFF input was provided."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有提供 TIFF 扫描稿。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "TIFFスキャンが選択されていません。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha indicado ningún TIFF."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun TIFF n’a été fourni."
          }
        }
      }
    },
    "ERR_OUTPUT_COLLISION": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Output files already exist. Change the roll name or output folder."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输出文件已存在，请更换胶卷名称或输出位置。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同名の出力ファイルがあります。ロール名または出力先を変更してください。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya existen archivos de salida. Cambia el nombre del carrete o la carpeta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des fichiers de sortie existent déjà. Modifiez le nom ou le dossier."
          }
        }
      }
    },
    "ERR_PREVIEW_PARTIAL": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One or more scans could not be previewed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "部分扫描稿无法生成预览。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一部のスキャンをプレビューできませんでした。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo previsualizar uno o más escaneos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un ou plusieurs scans n’ont pas pu être prévisualisés."
          }
        }
      }
    },
    "ERR_PROCESS": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Processing failed. No partial output was kept."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "处理失败，未保留不完整文件。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "処理に失敗しました。不完全な出力は保存されていません。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El proceso falló. No se conservó ninguna salida parcial."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le traitement a échoué. Aucun fichier partiel n’a été conservé."
          }
        }
      }
    },

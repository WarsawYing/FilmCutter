    "about.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cut scanned film strips into individual frames.\nSupports 8/16-bit TIFF scans."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将胶片扫描稿裁切为独立画格。\n支持 8/16 位 TIFF 扫描稿。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スキャンしたフィルムを1コマずつTIFFに切り出します。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recorta película escaneada en fotogramas TIFF individuales."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Découpe les films numérisés en vues TIFF individuelles."
          }
        }
      }
    },
